# Get standard libraries
util math
util string
util io
util rustPath

# Get module
use multiply

# Get arguments
l_operand = rsStrToi32(rsArg(1))
operator = rsArg(2)
r_operand = rsStrToi32(rsArg(3))

# Calculate and print
if rsStrEq(operator, "+"):
    say rsi32ToStr(rsAdd(l_operand, r_operand))
if rsStrEq(operator, "-"):
    say rsi32ToStr(rsSub(l_operand, r_operand))
if rsStrEq(operator, "x"):
    say rsi32ToStr(nimMult(l_operand, r_operand))