util math
util string
util io
util rsPath
util ansiColors

use multiply

l_operand = strToi32(arg(1))
operator = arg(2)
r_operand = strToi32(arg(3))

if strEq(operator, "+"):
    say colorRed(i32ToStr(add(l_operand, r_operand)))
if strEq(operator, "-"):
    say colorRed(i32ToStr(sub(l_operand, r_operand)))
if strEq(operator, "x"):
    say colorRed(i32ToStr(mult(l_operand, r_operand)))
